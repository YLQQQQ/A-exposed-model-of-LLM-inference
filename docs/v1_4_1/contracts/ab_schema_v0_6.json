              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            "clock_domain_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "ACTIVITY"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "VALID"
                  },
                  "activity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "end_ns": {
                    "type": "integer",
                    "minimum": -9223372036854775808,
                    "maximum": 9223372036854775807
                  },
                  "clock_domain_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "COMPLETION_BOUNDARY"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "VALID"
                  },
                  "activity_id": {
                    "type": "null"
                  },
                  "end_ns": {
                    "type": "integer",
                    "minimum": -9223372036854775808,
                    "maximum": 9223372036854775807
                  },
                  "clock_domain_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "NONE"
                  }
