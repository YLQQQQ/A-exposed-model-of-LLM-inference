          "properties": {
            "status": {
              "enum": [
                "VALID",
                "NOT_APPLICABLE",
                "AMBIGUOUS",
                "INVALID"
              ]
            },
            "kind": {
              "enum": [
                "ACTIVITY",
                "COMPLETION_BOUNDARY",
                "NONE"
              ]
