{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exposedpath.dev/schemas/derived_schema_v0_3.json",
  "title": "ExposedPath Derived Exposure Schema v0.3",
  "description": "Engineering/Pre-Pilot machine contract for navigation-only D and A/B-only Exposure Signature projections.",
  "schema_version": "exposedpath-derived/0.3.0",
  "measurement_contract_version": "exposedpath-measurement-contract-0.2.0",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/d_window_record"
    },
    {
      "$ref": "#/$defs/exposure_signature_record"
    }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "validation_role",
        "measurement_validity",
        "measurement_contract_version",
        "input_schema_version",
        "analyzer_version",
        "generated_at_utc",
        "data_role",
        "source",
        "files",
        "summary",
        "research_eligibility"
      ],
      "properties": {
        "validation_role": {"const":"LOCAL_DETERMINISTIC_ONLY"},
        "measurement_validity": {"const":"NOT_ASSESSED"},
        "schema_version": {
          "const": "exposedpath-derived/0.3.0"
        },
        "measurement_contract_version": {
          "const": "exposedpath-measurement-contract-0.2.0"
        },
        "input_schema_version": {
          "const": "exposedpath-ab/0.3.0"
        },
        "analyzer_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "data_role": {
          "type": "string",
          "enum": [
            "Prototype",
            "Engineering",
            "Pilot",
            "Formal"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "ab_manifest_name",
            "ab_manifest_sha256",
            "a_window_records_sha256",
            "b_sync_records_sha256"
          ],
          "properties": {
            "ab_manifest_name": {
              "const": "ab_manifest.json"
            },
            "ab_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{64}$"
            },
            "a_window_records_sha256": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{64}$"
            },
            "b_sync_records_sha256": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "files": {
          "type": "object",
          "required": [
            "d_window_records",
            "exposure_signature_records"
          ],
          "properties": {
            "d_window_records": {
              "type": "object",
              "required": [
                "filename",
                "record_count",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "filename": {
                  "const": "d_window_records.jsonl.gz"
                },
                "record_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "exposure_signature_records": {
              "type": "object",
              "required": [
                "filename",
                "record_count",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "filename": {
                  "const": "exposure_signature_records.jsonl.gz"
                },
                "record_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "required": [
            "d_window_count",
            "exposure_signature_count"
          ],
          "properties": {
            "d_window_count": {
              "type": "integer",
              "minimum": 0
            },
            "exposure_signature_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "research_eligibility": {
          "type": "object",
          "required": [
            "formal_evidence",
            "q0_status",
            "scope"
          ],
          "properties": {
            "formal_evidence": {
              "type": "boolean"
            },
            "q0_status": {
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED",
                "NOT_RUN"
              ]
            },
            "scope": {
              "const": "DERIVED_FROM_A_B_ONLY"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
