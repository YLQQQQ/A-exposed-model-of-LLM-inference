{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exposedpath.local/schema/q0-execution-0.2.1.json",
  "title": "ExposedPath Q0 pre-GPU execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "oracle_version",
    "contract_version",
    "data_role",
    "identity_mapping",
    "research_eligibility",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "exposedpath-q0-execution/0.2.1"},
    "oracle_version": {"const": "exposedpath-q0-oracle-0.2.0"},
    "contract_version": {"const": "exposedpath-measurement-contract-0.2.0"},
    "data_role": {"const": "Engineering"},
    "identity_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "sync", "timestamp_identity_forbidden"],
      "properties": {
        "activity": {"const": "NVTX_MARKER_CALLSITE_VIA_CUDA_API_CORRELATION"},
        "sync": {"const": "NVTX_SYNC_CALLSITE_ID"},
        "timestamp_identity_forbidden": {"const": true}
      }
    },
    "research_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_evidence", "q0_status", "scope"],
      "properties": {
        "formal_evidence": {"const": false},
        "q0_status": {"const": "NOT_RUN"},
        "scope": {"const": "Q0_PRE_GPU_ONLY"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "labels": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "required_for_q0",
        "execution_strategy",
        "native_seed_case_id",
        "fault_injection",
        "synthetic_profile",
        "measurement_initialization",
        "activity_labels",
        "sync_labels",
        "non_sync_api_labels"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^Q0-[A-Z0-9-]+$"},
        "required_for_q0": {"type": "boolean"},
        "execution_strategy": {
          "enum": [
            "NATIVE_CUDA",
            "NATIVE_WITH_CANONICAL_FAULT",
            "SYNTHETIC_CANONICAL"
          ]
        },
        "native_seed_case_id": {"type": ["string", "null"]},
        "fault_injection": {
          "enum": [
            null,
            "REMOVE_ACTIVITY_CORRELATION",
            "MARK_TRACE_DROPPED",
            "REMOVE_GRAPH_NODE_MAPPING"
          ]
        },
        "synthetic_profile": {"type": "string", "minLength": 1},
        "measurement_initialization": {
          "enum": ["NONE", "PRE_CAPTURE_SAME_KERNEL_WARMUP"]
        },
        "activity_labels": {"$ref": "#/$defs/labels"},
        "sync_labels": {"$ref": "#/$defs/labels"},
        "non_sync_api_labels": {"$ref": "#/$defs/labels"}
      }
    }
  }
}
