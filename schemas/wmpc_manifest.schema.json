{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exposedpath.dev/schemas/wmpc_manifest.schema.json",
  "title": "WMPC Manifest",
  "description": "Workload-Model-Platform-Configuration manifest for an inference run.",
  "type": "object",
  "required": [
    "experiment_id", "wmpc_id", "run_id", "run_role",
    "fixed_input_tokens", "fixed_output_tokens", "batch_size",
    "model_id", "dtype_and_quantization",
    "gpu_model", "cuda_version_used", "inference_framework_version",
    "execution_mode", "warmup_count", "repeat_count"
  ],
  "properties": {
    "experiment_id": {"type": "string"},
    "wmpc_id": {"type": "string"},
    "run_id": {"type": "string"},
    "run_role": {"type": "string", "enum": ["PILOT", "FORMAL"]},
    "prompt_tokens_file": {"type": "string"},
    "prompt_tokens_sha256": {"type": "string"},
    "fixed_input_tokens": {"type": "integer", "exclusiveMinimum": 0},
    "fixed_output_tokens": {"type": "integer", "exclusiveMinimum": 0},
    "batch_size": {"type": "integer", "exclusiveMinimum": 0},
    "sampling_config": {"type": "object"},
    "model_id": {"type": "string"},
    "revision": {"type": "string"},
    "model_type": {"type": "string"},
    "dtype_and_quantization": {"type": "string"},
    "num_parameters": {},
    "num_hidden_layers": {"type": "integer"},
    "hidden_size": {"type": "integer"},
    "num_attention_heads": {"type": "integer"},
    "num_key_value_heads": {"type": "integer"},
    "intermediate_size": {"type": "integer"},
    "max_position_embeddings": {"type": "integer"},
    "cpu_model": {"type": "string"},
    "gpu_model": {"type": "string"},
    "platform_snapshot_file": {"type": "string"},
    "os_distribution_version": {"type": "string"},
    "nvidia_driver_version": {"type": "string"},
    "cuda_version_used": {"type": "string"},
    "inference_framework_version": {"type": "string"},
    "runtime_version": {"type": "string"},
    "attention_backend": {"type": "string"},
    "execution_mode": {"type": "string"},
    "warmup_count": {"type": "integer", "minimum": 0},
    "repeat_count": {"type": "integer", "exclusiveMinimum": 0},
    "cpu_affinity_spec": {},
    "numa_binding_policy": {},
    "framework_threading_config": {},
    "gpu_power_persistence_policy": {},
    "external_cuda_workload_policy": {},
    "runner_git_commit": {"type": "string"},
    "runner_git_dirty": {"type": "boolean"},
    "pass0_command": {"type": "string"},
    "pass1_nsys_command": {"type": "string"}
  }
}
